project Edge_Gate is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("edge_gate_demo.adb");

   package Compiler is
      --  -gnata enables contracts at run time so the demo also checks them.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnata", "-g");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all", "--checks-as-errors=on");
   end Prove;

end Edge_Gate;
